# =============================================================================
# Cyber Cage — Frontend Environment Variables
# =============================================================================
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel production deployment, add VITE_API_URL in the Vercel dashboard:
#   Project Settings → Environment Variables → VITE_API_URL
#
# =============================================================================

# Full URL to the deployed FastAPI backend (no trailing slash)
# Local development default (Vite proxy handles /api/* automatically):
VITE_API_URL=http://localhost:8000

# Production example (replace with your actual deployment URL):
# VITE_API_URL=https://your-fastapi-backend.onrender.com
