  "event_type_regex": {
    "(?i).*(login|signin|logon|auth|authenticate).*": "LOGIN",
    "(?i).*(logout|signout|logoff).*": "LOGOUT",
    "(?i).*(download|fetch|pull|exfil).*": "FILE_DOWNLOAD",
    "(?i).*(upload|push|post).*": "FILE_UPLOAD",
    "(?i).*(read|open|access_file).*": "FILE_READ",
    "(?i).*(write|save|modify_file).*": "FILE_WRITE",
    "(?i).*(process|exec|cmd|powershell|run).*": "PROCESS_START",
    "(?i).*(stop|kill|terminate).*": "PROCESS_STOP",
    "(?i).*(sql|query|select|database).*": "DATABASE_QUERY",
    "(?i).*(vpn).*": "VPN_CONNECT",
    "(?i).*(api|http|rest).*": "API_CALL",
    "(?i).*(resource|view|access).*": "RESOURCE_ACCESS"
  },
